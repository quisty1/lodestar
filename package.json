{
  "name": "lodestar",
  "private": true,
  "version": "1.0.0",
  "description": "Lodestar — browser extension for LinkedIn SSI growth (safety-first, pull > push). Chrome Manifest V3.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:dist": "node scripts/verify-extension.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "release:check": "npm test && npm run build && npm run verify:dist && npm run package:extension"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "unicode-case-folding": "^1.1.1",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.1.10"
  }
}
